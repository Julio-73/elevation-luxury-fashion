# ============================================================
#  ÉLÉVATION — .gitignore
# ============================================================

# ---------- Temporales de desarrollo / preview local ----------
.preview/
_imgcheck/
_preview_*.html
_audit.html
*.local.html
tmp/
.tmp/
temp/

# ---------- Capturas de pantalla y QA visual ----------
shots/
_shots/
screenshots/
*.shot.png
*.shot.jpg

# ---------- Sistema operativo ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ---------- Editores e IDE ----------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.code-workspace
*.swp
*.swo
*~
.history/
*.orig

# ---------- Dependencias y build (si se añade tooling) ----------
node_modules/
.pnpm-store/
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
coverage/
*.tsbuildinfo

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ---------- Variables de entorno y secretos ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Empaquetados ----------
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ---------- Archivos del sistema / bloqueos ----------
*.lnk
*.bak
*.tmp
